# Optional: uncomment if candle data is too large
# oanda_h1_ba_live/

# Losing candidate models are never loaded at runtime (~430 MB across pairs).
# Only models/<PAIR>/best_model.pkl + metadata are used by the service.
models/*/candidate_models/

