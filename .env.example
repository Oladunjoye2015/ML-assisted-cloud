# ==========================================================================
# ML-Assisted-Cloud — environment template
# Copy to .env and fill in secrets.  .env is gitignored; NEVER commit real keys.
# Values shown are the code defaults unless noted. Booleans are "true"/"false".
# ==========================================================================

# ---- Broker (OANDA) — REQUIRED --------------------------------------------
OANDA_TOKEN=                                   # OANDA v20 API token (secret)
OANDA_ACCOUNT_ID=                              # e.g. 001-004-1234567-001
OANDA_BASE_URL=https://api-fxtrade.oanda.com   # practice: https://api-fxpractice.oanda.com

# ---- Paths ----------------------------------------------------------------
MODELS_DIR=models
LOG_DIR=logs
DATA_DIR=oanda_h1_ba_live       # NOTE: training script defaults to data/oanda_h1_ba_live
                                # — keep these consistent (see audit finding M7).
# DB_PATH=logs/fx_trading.db    # defaults to <LOG_DIR>/fx_trading.db

# ---- Position sizing / risk ----------------------------------------------
USE_EQUITY_SIZING=true
RISK_PCT=0.0015                 # fraction of equity risked per trade (0.15%)
DEFAULT_EQUITY=200
UNITS_NON_JPY=2000
UNITS_JPY=1000
MIN_UNITS_NON_JPY=100
MIN_UNITS_JPY=100
MAX_UNITS_NON_JPY=5000
MAX_UNITS_JPY=3000

# ---- Trade caps (capital protection) -------------------------------------
MAX_OPEN_TRADES=1
MAX_TRADES_PER_DAY_PER_PAIR=1
MAX_TRADES_PER_DAY_TOTAL=3
DUP_WINDOW_SECONDS=300          # suppress identical signals within this window
# H2: a /predict recommendation reserves a cap slot as "pending"; a confirmed fill via
# /trade_event retires it, otherwise it expires after this TTL so an unfilled
# recommendation can't permanently consume the day's budget.
RESERVATION_TTL_SECONDS=300
# H2: periodically compare tracked open trades against the broker and log drift.
BROKER_RECONCILE_ENABLED=true
BROKER_RECONCILE_AUTOCORRECT=false   # true = also drop tracked trades the broker no longer shows

# ---- Auto-close worker ----------------------------------------------------
AUTO_CLOSE_ENABLED=true
MAX_HOLD_MINUTES=60
AUTO_CLOSE_CHECK_SECONDS=1800   # AUDIT H3: 1800s vs 60m hold => positions can run
                                # ~50% over the limit. Recommend <= 900.
AUTO_CLOSE_ALLOW_POSITION_FALLBACK=false

# ---- Model gates (live operating point) ----------------------------------
CONF_GATE=0.54
MARGIN_GATE=0.04
DEFAULT_DISAGREE_CONF=0.62      # min confidence to trade against an incoming hint
MIN_PAIR_SCORE_TO_TRADE=0.30    # NOTE: training script uses 0.25 — reconcile (M7)
MIN_AUC_TO_TRADE=0.52
MIN_PRECISION_TO_TRADE=0.55

# ---- SL/TP (must match training labels) ----------------------------------
DEFAULT_SL_ATR=0.90
DEFAULT_TP_ATR=1.40
# Training-side barrier definition (03_train_h1_auto_models.py):
SL_ATR=1.0
TP_ATR=1.3
HORIZON_BARS=8                  # bars the ATR-barrier label looks forward

# ---- Feature source -------------------------------------------------------
MODEL_FEATURE_SOURCE=hybrid                 # hybrid | oanda | alert
MODEL_FEATURE_OANDA_GRANULARITY=H1
MODEL_FEATURE_OANDA_CANDLE_COUNT=240
MODEL_FEATURE_OANDA_MIN_CANDLES=80
MODEL_FEATURE_FALLBACK_TO_ALERT=true
BAR_HISTORY_LEN=300

# ---- Multi-timeframe market context --------------------------------------
MARKET_CONTEXT_ENABLED=true
MARKET_CONTEXT_GRANULARITIES=H1,H4,D
MARKET_CONTEXT_CANDLE_COUNT=160
MARKET_CONTEXT_MAX_FETCH_SECONDS=20
MARKET_CONTEXT_REQUIRED=false

# ---- Signal freshness / live price ---------------------------------------
SIGNAL_STALENESS_GUARD_ENABLED=true
SIGNAL_MAX_AGE_SECONDS=7200
LIVE_PRICE_MAX_AGE_SECONDS=20

# ---- Noise filter ---------------------------------------------------------
NOISE_FILTER_ENABLED=true
NOISE_FILTER_REQUIRE_TREND_ALIGNMENT=false
MIN_NOISE_ATR_PIPS=5.0
MIN_NOISE_RANGE_PIPS=3.0
MIN_RANGE_ATR_RATIO=0.20
MIN_BODY_RANGE_RATIO=0.12
MAX_WICK_BODY_RATIO=8.0
MAX_SPREAD_PIPS=3.5
MAX_SPREAD_RANGE_RATIO=0.35

# ---- Direction-confirmation guard ----------------------------------------
DIRECTION_CONFIRMATION_ENABLED=true
DIRECTION_CONFIRMATION_REQUIRED=false
DIRECTION_CONFIRM_MIN_SCORE=3
DIRECTION_CONFIRM_MIN_BODY_PIPS=2.0
DIRECTION_CONFIRM_STRONG_BODY_RATIO=0.45
DIRECTION_CONFIRM_EMA_BUFFER_PIPS=0.5
DIRECTION_CONFIRM_BLOCK_STRONG_OPPOSITE_CANDLE=true
DIRECTION_CONFIRM_REJECT_COUNTERTREND_EMA50=false
DIRECTION_CONFIRM_REJECT_COUNTERTREND_EMA200=false
MIN_TREND_DIST_ABS=0.00005

# ---- Entry-reversal guard -------------------------------------------------
ENTRY_REVERSAL_GUARD_ENABLED=true
ENTRY_REVERSAL_GUARD_REQUIRED=false
ENTRY_REVERSAL_MAX_ADVERSE_PIPS=4.0
ENTRY_REVERSAL_MAX_SPREAD_PIPS=3.2

# ---- Technical review (multi-timeframe) ----------------------------------
TECHNICAL_REVIEW_ENABLED=true
TECHNICAL_REVIEW_REQUIRED=true
TECH_MIN_SCORE_FOR_BUY=62
TECH_MIN_SCORE_FOR_SELL=62
TECH_STRONG_SCORE=72
TECH_MIN_ALIGNED_TIMEFRAMES=2
TECH_REQUIRE_H1_ALIGNMENT=true
TECH_REQUIRE_H4_OR_D_ALIGNMENT=true
TECH_HARD_BLOCK_OPPOSITE_H1=true
TECH_HARD_BLOCK_OPPOSITE_H4=false
TECH_BLOCK_NEAR_SR=true
TECH_NEAR_SR_ATR_MULT=0.35
TECH_BLOCK_HIGH_SPREAD_ATR=true
TECH_MAX_SPREAD_ATR=0.18

# ---- News filter ----------------------------------------------------------
NEWS_FILTER_ENABLED=true
NEWS_BLOCK_BEFORE_MIN=60
NEWS_BLOCK_AFTER_MIN=30
NEWS_BLOCK_IMPACTS=HIGH,RED
NEWS_BLOCK_ALL_CURRENCIES=false
NEWS_BLOCK_UNKNOWN_CURRENCY=false
NEWS_KEEP_PAST_HOURS=24
NEWS_DEFAULT_TITLE=economic_news
NEWS_EVENTS_JSON=               # optional path to a news-events JSON file
NEWS_MANUAL_BLACKOUT_UTC=       # optional manual blackout windows (UTC)

# ---- AI signal review (optional; off by default) -------------------------
AI_REVIEW_ENABLED=false
AI_REVIEW_PROVIDER=openai        # openai | anthropic
AI_REVIEW_MODEL=gpt-4o-mini
AI_REVIEW_REQUIRE_APPROVAL=true
AI_REVIEW_FALLBACK_TO_RULES=true # if provider/key missing, use rule-based review
AI_REVIEW_TIMEOUT_SECONDS=25     # NOTE: blocking call in the /predict path (H4)
AI_REVIEW_MIN_MODEL_PROB=0.52
AI_REVIEW_STRONG_MODEL_PROB=0.58
AI_REVIEW_MAX_SPREAD_ATR=0.18
AI_REVIEW_MAX_RISK_SCORE=60
AI_REVIEW_CONDITIONAL_RISK_SCORE=75
AI_REVIEW_HARD_BLOCK_SCORE=85
OPENAI_API_KEY=                  # secret; required only if provider=openai
ANTHROPIC_API_KEY=               # secret; required only if provider=anthropic

# ---- Model registry -------------------------------------------------------
AUTO_MODEL_REGISTRY_ENABLED=true
AUTO_REGISTRY_OVERRIDES_JOBLIB=true

# ==========================================================================
# TRAINING-ONLY (03_train_h1_auto_models.py)
# ==========================================================================
RANDOM_STATE=42
VALID_FRACTION=0.20
MIN_ROWS_AFTER_FEATURES=1500
MIN_VALID_ROWS=250
MIN_GATE_TRADES=30
MIN_TRADES_FOR_PAIR_SCORING=20
AUC_WEIGHT=0.80
WINRATE_WEIGHT=0.20

# ---- TCN (deep-learning) model -------------------------------------------
TRAIN_TCN=true
TCN_EPOCHS=12
TCN_BATCH_SIZE=256
TCN_LR=0.001
TCN_LOOKBACK=48
TCN_WINDOW=48
TCN_MIN_AUC=0.53
TCN_MIN_PRECISION_EDGE=0.03
TCN_MIN_PAIR_SCORE=0.35
TCN_MIN_TRADES=30
MAX_TCN_TRAIN_SEQUENCES=12000
